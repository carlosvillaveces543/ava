function esc(v=''){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function val(id,root=document){return $(id,root)?.value?.trim?.() ?? ''}
function num(v){const n=Number(String(v??'').replace(/[^0-9,.-]/g,'').replace(',','.'));return Number.isFinite(n)?n:0}
function round2(n){return Math.round((Number(n)+Number.EPSILON)*100)/100}
function money(n,dec=0){return new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',minimumFractionDigits:dec,maximumFractionDigits:2}).format(num(n))}
function normalizeName(s=''){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toLowerCase().replace(/\s+/g,' ')}
function docKey(name=''){return encodeURIComponent(normalizeName(name)).replaceAll('%','_').replaceAll('.','_2E').slice(0,500) || crypto.randomUUID()}
