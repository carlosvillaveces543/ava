function bogotaDate(date,time='00:00'){return new Date(`${date}T${time}:00-05:00`)}
function tsToDate(v){return v?.toDate?v.toDate():v instanceof Date?v:new Date(v||0)}
function formatDate(v,opts={}){const d=typeof v==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(v)?bogotaDate(v,'12:00'):tsToDate(v);return new Intl.DateTimeFormat('es-CO',{timeZone:BOGOTA_TZ,day:'2-digit',month:'short',year:'numeric',...opts}).format(d)}
function formatTime(v){const d=tsToDate(v);return new Intl.DateTimeFormat('es-CO',{timeZone:BOGOTA_TZ,hour:'numeric',minute:'2-digit',hour12:true}).format(d)}
function formatDateTime(v){return `${formatDate(v)} · ${formatTime(v)}`}
function minutesToTime(m){const h=Math.floor(m/60)%24,mm=m%60;return `${String(h).padStart(2,'0')}:${String(mm).padStart(2,'0')}`}
function timeToMinutes(t='00:00'){const [h,m]=t.split(':').map(Number);return h*60+m}
function addDays(key,days){const d=bogotaDate(key,'12:00');d.setUTCDate(d.getUTCDate()+days);return dateKey(d)}
function dateRangeOk(key,from,to){return (!from||key>=from)&&(!to||key<=to)}
function currentMonthKey(){return dateKey().slice(0,7)}
function initials(name='AVA'){return name.split(/\s+/).slice(0,2).map(x=>x[0]?.toUpperCase()||'').join('')}
function debounce(fn,ms=450){let t;return (...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms)}}
function randomId(prefix='id'){return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2,8)}`}
function hasSection(id){return state.profile?.role==='Administrador'||(state.profile?.enabledSections||[]).includes(id)}
function productsEnabled(){return state.settings?.sellsProducts !== false}
function safePhone(v=''){return String(v).replace(/\D/g,'').replace(/^57(?=3\d{9}$)/,'')}
function waPhone(v=''){const p=safePhone(v);return p.length===10?`57${p}`:p}
function statusPill(text,type='gold'){return `<span class="pill pill-${type}">${esc(text)}</span>`}
function empty(text='No hay registros todavía',ico='◇'){return `<div class="empty"><span class="eico">${ico}</span>${esc(text)}</div>`}

