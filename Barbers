      $("#loginForm").onsubmit=async e=>{e.preventDefault();const btn=$("#loginSubmit");setBusy(btn,true,"Ingresando...");try{await signInWithEmailAndPassword(auth,$("#loginEmail").value.trim(),$("#loginPassword").value);}catch(err){toast("No se pudo iniciar sesión","error",firebaseMessage(err));setBusy(btn,false)}};
      $("#resetPasswordBtn").onclick=async()=>{const email=$("#loginEmail").value.trim();if(!email){toast("Escribe primero tu correo","error");return}try{await sendPasswordResetEmail(auth,email);toast("Correo de recuperación enviado");}catch(err){toast("No se pudo enviar el correo","error",firebaseMessage(err))}};
    }

    async function bootstrapProfile(user){
      const userRef=doc(db,"users",user.uid); const snap=await getDoc(userRef); if(snap.exists())return snap.data();
      const profile={uid:user.uid,name:user.displayName||user.email?.split("@")[0]||"Administrador",email:user.email||"",role:"Administrador",permissions:ALL_PERMISSIONS,menuOrder:ALL_PERMISSIONS,active:true,createdAt:serverTimestamp(),updatedAt:serverTimestamp()};
      try{
        await runTransaction(db,async tx=>{
          const configRef=doc(db,"config","main"); const c=await tx.get(configRef);
          if(c.exists())throw new Error("Este usuario no tiene un perfil autorizado en AVA.");
          tx.set(userRef,profile); tx.set(configRef,{...structuredClone(DEFAULT_CONFIG),createdAt:serverTimestamp(),updatedAt:serverTimestamp()}); tx.set(doc(db,"publicConfig","main"),publicConfigFrom(DEFAULT_CONFIG));
          tx.set(doc(db,"counters","purchases"),{value:0});tx.set(doc(db,"counters","invoices"),{value:0});tx.set(doc(db,"counters","appointmentNotifications"),{count:0});
        });
        return {...profile,createdAt:null,updatedAt:null};
      }catch(err){throw new Error(err.message||"No fue posible inicializar el administrador. Revisa las reglas de Firestore.")}
    }

    async function startPrivateApp(user){
      state.user=user;
      try{state.profile=await bootstrapProfile(user);}catch(err){await signOut(auth);toast("Acceso no autorizado","error",firebaseMessage(err));return}
      if(state.profile.active===false){await signOut(auth);toast("Este usuario está desactivado","error");return}
      $("#authView").classList.add("hidden");$("#publicView").classList.add("hidden");$("#appShell").classList.remove("hidden");
      $("#userName").textContent=state.profile.name||user.email;$("#userRole").textContent=state.profile.role||"Trabajador";$("#userAvatar").textContent=initials(state.profile.name||user.email);
      $("#sideBrandIcon").innerHTML=icon("scissors");$("#logoutBtn").innerHTML=icon("logout");$("#mobileMenuBtn").innerHTML=icon("menu");
      $("#logoutBtn").onclick=()=>signOut(auth);$("#mobileMenuBtn").onclick=()=>$("#sidebar").classList.toggle("open");$("#topNotificationBtn").onclick=()=>navigate("appointments");
      state.globalUnsubs.splice(0).forEach(fn=>fn?.());state.notificationInitialized=false;
      state.globalUnsubs.push(onSnapshot(doc(db,"users",user.uid),snap=>{if(!snap.exists()||snap.data().active===false){signOut(auth);return}state.profile=snap.data();$("#userName").textContent=state.profile.name;$("#userRole").textContent=state.profile.role;$("#userAvatar").textContent=initials(state.profile.name);renderNavigation();}));
      state.globalUnsubs.push(onSnapshot(doc(db,"config","main"),snap=>{state.config=snap.exists()?deepMerge(structuredClone(DEFAULT_CONFIG),snap.data()):structuredClone(DEFAULT_CONFIG);$("#sideBusinessName").textContent=state.config.business.name||"Gestión de barbería";renderNavigation();if(state.activeView==="dashboard"&&Object.values(state.dashboardData||{}).every(Array.isArray))renderDashboardMetrics();}));
      state.globalUnsubs.push(onSnapshot(doc(db,"counters","appointmentNotifications"),snap=>{
        const count=snap.data()?.count||0; const seen=state.profile?.lastAppointmentCounter||0; const previous=state.notificationCounter;state.notificationCounter=count;state.notificationCount=Math.max(0,count-seen);renderNavigation();if(state.notificationInitialized&&count>previous)playNotification();state.notificationInitialized=true;
      }));
      let preferred=localStorage.getItem("ava-last-view")||"dashboard";if(!hasAccess(preferred))preferred=availableNav()[0]?.id||"dashboard";state.activeView=preferred;renderNavigation();updateClock();await renderActiveView();
    }

    function deepMerge(target,source){
      if(!source||typeof source!=="object")return target;for(const [k,v] of Object.entries(source)){if(v&&typeof v==="object"&&!Array.isArray(v)&&!(v instanceof Timestamp)){target[k]=deepMerge(target[k]&&typeof target[k]==="object"?target[k]:{},v)}else target[k]=v}return target;
    }

