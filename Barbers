      $$('[data-bottom]',$("#bottomNav")).forEach(b=>b.onclick=()=>b.dataset.bottom==="more"?$("#sidebar").classList.add("open"):navigate(b.dataset.bottom));
      const item=navItem(state.activeView); $("#topbarTitle").textContent=item.label; $("#topbarSubtitle").textContent=item.subtitle;
      $("#topNotificationBtn").innerHTML=icon("bell")+(state.notificationCount?`<span class="nav-badge" style="position:absolute;transform:translate(12px,-12px)">${state.notificationCount}</span>`:"");
    }

