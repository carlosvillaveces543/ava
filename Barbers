        let purchaseNumber=0;
        await runTransaction(db,async tx=>{
          const counterRef=doc(db,"counters","purchases"),counterSnap=await tx.get(counterRef);purchaseNumber=(counterSnap.data()?.value||0)+1;
          const refs=[...grouped.values()].map(g=>({g,invRef:doc(db,"inventory",g.id),prodRef:doc(db,"products",g.id)}));
          const snapshots=await Promise.all(refs.flatMap(r=>[tx.get(r.invRef),tx.get(r.prodRef)]));
          tx.set(counterRef,{value:purchaseNumber,updatedAt:serverTimestamp()},{merge:true});
          const purchaseRef=doc(collection(db,"purchases"));tx.set(purchaseRef,{number:purchaseNumber,items,total,dateKey:todayKey(),createdAt:serverTimestamp(),createdBy:{uid:state.user.uid,name:state.profile.name}});
          refs.forEach((r,index)=>{const invSnap=snapshots[index*2],prodSnap=snapshots[index*2+1],oldStock=invSnap.data()?.stock||0,oldPvp=prodSnap.data()?.pvp||0;tx.set(r.invRef,{name:r.g.description,normalizedName:normalize(r.g.description),type:"Producto Venta",unit:r.g.unit,stock:round2(oldStock+r.g.quantity),lastUnitCost:r.g.unitValue,updatedAt:serverTimestamp(),createdAt:invSnap.data()?.createdAt||serverTimestamp()},{merge:true});tx.set(r.prodRef,{name:r.g.description,normalizedName:normalize(r.g.description),costUnit:r.g.unitValue,pvp:oldPvp,unit:r.g.unit,updatedAt:serverTimestamp(),createdAt:prodSnap.data()?.createdAt||serverTimestamp()},{merge:true})});
        });
