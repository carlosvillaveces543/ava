  const name=fromAgenda?agendaData.clientName:(val('#invoiceClient')||'General'),phone=fromAgenda?agendaData.phone:val('#invoicePhone');const payment=fromAgenda?agendaData.payment:readPayment(total);
  if(payment.balance>0){toast('El monto recibido debe cubrir el total de la venta.','error');return false} // NUEVO: evita crear saldos pendientes tras eliminar Cartera.
  if(payment.split){const sum=round2(payment.payments.reduce((s,x)=>s+x.amount,0));if(Math.abs(sum-Math.min(payment.received,total))>.01){toast('Los montos del pago dividido deben sumar el monto recibido.','error');return false}}
  const client=await findOrCreateClient(name,phone); // MODIFICADO: se crea/consulta el cliente solo después de validar el pago completo.
  const button=fromAgenda?null:$('#saveInvoice');if(button){button.disabled=true;button.textContent='Guardando…'}
  try{
    await runTransaction(db,async tx=>{
      const counterRef=doc(db,'counters','main'),counterSnap=await tx.get(counterRef),invoiceNo=(counterSnap.data()?.invoiceNo||0)+1,saleNo=(counterSnap.data()?.saleNo||0)+1; // MODIFICADO: toda factura guardada pasa directamente a Ventas.
      const productGroups=new Map();items.filter(x=>x.kind==='product').forEach(x=>productGroups.set(x.sourceId,round2((productGroups.get(x.sourceId)||0)+x.quantity)));
      const invSnaps=new Map();for(const [id] of productGroups){const ref=doc(db,'inventory',id),snap=await tx.get(ref);if(!snap.exists()||num(snap.data().stock)<productGroups.get(id))throw new Error(`Stock insuficiente para ${items.find(x=>x.sourceId===id)?.name||'un producto'}.`);invSnaps.set(id,{ref,snap})}
      tx.set(counterRef,{invoiceNo,saleNo,updatedAt:serverTimestamp()},{merge:true});
      for(const [id,qty] of productGroups){const x=invSnaps.get(id);tx.update(x.ref,{stock:round2(num(x.snap.data().stock)-qty),updatedAt:serverTimestamp()})}
      const cleanItems=items.map(({tempId,...x})=>x),base={invoiceNo,clientId:client?.id||'',clientName:client?.name||name||'General',phone:safePhone(phone),items:cleanItems,total,received:payment.received,change:payment.change,payments:payment.payments,dateKey:dateKey(),createdAt:serverTimestamp(),createdBy:state.user.uid,sourceAppointmentId:agendaData?.appointmentId||''};
      const ref=doc(collection(db,'sales'));tx.set(ref,{...base,saleNo,status:'paid'}); // MODIFICADO: eliminado el destino alternativo de Cartera.
      if(agendaData?.appointmentId){tx.delete(doc(db,'appointments',agendaData.appointmentId));(agendaData.slotKeys||[]).forEach(k=>tx.delete(doc(db,'appointmentSlots',k)))}
    });
    toast('Venta registrada.');if(!fromAgenda){state.temp.invoice=[];await navigate('billing',true)}return true; // MODIFICADO
  }catch(e){toast(errorText(e),'error');if(button){button.disabled=false;button.textContent='Guardar venta'}return false}
}

