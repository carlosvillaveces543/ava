function formatClock(t){const [h,m]=t.split(':').map(Number);const suffix=h>=12?'p. m.':'a. m.';const hh=h%12||12;return `${hh}:${String(m).padStart(2,'0')} ${suffix}`}
function serviceIntervals(s){
  const open=timeToMinutes(s.opening||'08:00'),lc=timeToMinutes(s.lunchClose||'12:00'),re=timeToMinutes(s.reopen||'14:00'),close=timeToMinutes(s.closing||'19:00');
  const ranges=[];if(open<lc)ranges.push([open,lc]);if(re<close)ranges.push([re,close]);if(!ranges.length&&open<close)ranges.push([open,close]);return ranges;
}
function slotKeys(date,start,count,duration){return Array.from({length:count},(_,i)=>`${date}_${minutesToTime(start+i*duration).replace(':','')}`)}
async function availableSlots(date,people,s,excludeKeys=[]){
  const duration=Math.max(5,num(s.cutDuration)||30),needed=Math.max(1,people),out=[];
  const slotsSnap=await getDocs(query(collection(db,'appointmentSlots'),where('dateKey','==',date)));
  const occupied=new Set(slotsSnap.docs.map(d=>d.id));excludeKeys.forEach(k=>occupied.delete(k));
  for(const [a,b] of serviceIntervals(s))for(let start=a;start+duration*needed<=b;start+=duration){
    const keys=slotKeys(date,start,needed,duration);if(keys.every(k=>!occupied.has(k)))out.push(minutesToTime(start));
  }
  return out;
}
async function createAppointment({name,phone,service,people,date,time,settings}){
  const start=timeToMinutes(time),duration=Math.max(5,num(settings.cutDuration)||30),keys=slotKeys(date,start,people,duration),appointmentRef=doc(collection(db,'appointments'));
  await runTransaction(db,async tx=>{
    for(const key of keys){const r=doc(db,'appointmentSlots',key),snap=await tx.get(r);if(snap.exists())throw new Error('Ese horario acaba de ser reservado. Elige otro.');}
    const startsAt=Timestamp.fromDate(bogotaDate(date,time));
    tx.set(appointmentRef,{clientName:name,phone,serviceId:service.id,serviceName:service.name,servicePrice:num(service.price),people,quantity:people,dateKey:date,time,startsAt,durationMinutes:duration*people,status:'scheduled',seen:false,createdBy:auth.currentUser?.uid||'',createdAt:serverTimestamp(),slotKeys:keys});
    keys.forEach(key=>tx.set(doc(db,'appointmentSlots',key),{appointmentId:appointmentRef.id,dateKey:date,timeKey:key.slice(-4),ownerUid:auth.currentUser?.uid||'',createdAt:serverTimestamp()}));
  });
}

