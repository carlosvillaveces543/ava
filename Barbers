async function ensureSettings(){
  const ref=doc(db,'settings','main');const snap=await getDoc(ref);
  if(!snap.exists()){const defaults={...defaultSettings(),initialized:true,createdAt:serverTimestamp(),updatedAt:serverTimestamp()};await setDoc(ref,defaults);await setDoc(doc(db,'publicSettings','main'),publicSettingsFrom(defaults));}
  await loadSettings();
