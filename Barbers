    async function openUserEditor(existing=null){
      const isEdit=!!existing;const role=existing?.role||"Trabajador";
      // MODIFICADO: limpia permisos/orden de módulos eliminados y garantiza que "Horarios Disponibles" aparezca en el editor.
      const savedOrder=(existing?.menuOrder?.length?existing.menuOrder:ALL_PERMISSIONS).filter(id=>NAV_ITEMS.some(n=>n.id===id));
      const order=[...savedOrder,...ALL_PERMISSIONS.filter(id=>!savedOrder.includes(id))];
      const permissions=role==="Administrador"?ALL_PERMISSIONS:(existing?.permissions||["dashboard","appointments","availability","billing","sales","clients"]).filter(id=>NAV_ITEMS.some(n=>n.id===id));
      const body=`<div class="form-grid"><div class="field col-6"><label>Nombre</label><input id="userEditName" value="${esc(existing?.name||"")}" placeholder="Juan Pérez"></div><div class="field col-6"><label>Correo</label><input id="userEditEmail" type="email" value="${esc(existing?.email||"")}" placeholder="barbero@negocio.com" ${isEdit?"readonly":""}></div>${isEdit?"":`<div class="field col-6"><label>Contraseña inicial</label><input id="userEditPassword" type="password" minlength="6" placeholder="Mínimo 6 caracteres"></div>`}<div class="field col-6"><label>Rol</label><select id="userEditRole"><option ${role==="Trabajador"?"selected":""}>Trabajador</option><option ${role==="Administrador"?"selected":""}>Administrador</option></select></div><div class="field col-12"><div class="switch-row"><div class="switch-copy"><b>Usuario activo</b><span>Al desactivarlo no podrá entrar al panel.</span></div><label class="switch"><input id="userEditActive" type="checkbox" ${existing?.active===false?"":"checked"}><span class="switch-slider"></span></label></div></div><div class="field col-12"><label>Acceso y orden del menú</label><small>Marca las secciones permitidas y arrastra para cambiar el orden.</small><div id="permissionDragList" class="drag-list">${order.map(id=>{const n=navItem(id);return `<div class="drag-item" draggable="true" data-permission-id="${id}"><span class="drag-handle">⋮⋮</span><input type="checkbox" ${permissions.includes(id)?"checked":""}><span>${icon(n.icon)} ${esc(n.label)}</span></div>`}).join("")}</div></div></div>`;
      const modalPromise=openModal({title:isEdit?"Editar usuario":"Crear usuario",subtitle:isEdit?"Actualiza rol, permisos y orden del menú.":"La contraseña se guarda únicamente en Firebase Authentication.",body,confirmText:isEdit?"Guardar cambios":"Crear usuario",large:true,onConfirm:async layer=>{
        const name=$("#userEditName",layer).value.trim(),email=$("#userEditEmail",layer).value.trim(),newRole=$("#userEditRole",layer).value,active=$("#userEditActive",layer).checked,items=$$('[data-permission-id]',layer),menuOrder=items.map(x=>x.dataset.permissionId),selected=items.filter(x=>$("input",x).checked).map(x=>x.dataset.permissionId),finalPermissions=newRole==="Administrador"?ALL_PERMISSIONS:selected;
        if(!name||!email){toast("Nombre y correo son obligatorios","error");return false}if(newRole==="Trabajador"&&!finalPermissions.length){toast("Asigna al menos una sección","error");return false}
        if(isEdit){await updateDoc(doc(db,"users",existing.id),{name,role:newRole,active,permissions:finalPermissions,menuOrder,updatedAt:serverTimestamp()});toast("Usuario actualizado");return true}
        const password=$("#userEditPassword",layer).value;if(password.length<6){toast("La contraseña debe tener mínimo 6 caracteres","error");return false}
        let credential;try{credential=await createUserWithEmailAndPassword(creatorAuth,email,password);await setDoc(doc(db,"users",credential.user.uid),{uid:credential.user.uid,name,email,role:newRole,active,permissions:finalPermissions,menuOrder,lastAppointmentCounter:state.notificationCounter,createdAt:serverTimestamp(),updatedAt:serverTimestamp()});await signOut(creatorAuth);toast("Usuario creado");return true}catch(err){try{await signOut(creatorAuth)}catch{}throw err}
      }});
      const layer=$("#modalLayer");let dragged=null;$$('.drag-item',layer).forEach(item=>{item.ondragstart=()=>{dragged=item;item.classList.add("dragging")};item.ondragend=()=>{item.classList.remove("dragging");dragged=null};item.ondragover=e=>{e.preventDefault();if(!dragged||dragged===item)return;const rect=item.getBoundingClientRect();item.parentNode.insertBefore(dragged,e.clientY<rect.top+rect.height/2?item:item.nextSibling)}});
      $("#userEditRole",layer).onchange=e=>{const admin=e.target.value==="Administrador";$$('[data-permission-id] input',layer).forEach(cb=>{if(admin)cb.checked=true;cb.disabled=admin})};
      if(role==="Administrador")$$('[data-permission-id] input',layer).forEach(cb=>cb.disabled=true);
      await modalPromise;
    }

