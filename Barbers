rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userData() {
      return get(userRef()).data;
    }
    function active() {
      return signedIn() && exists(userRef()) && userData().active != false;
    }
    function admin() {
      return active() && userData().role == 'Administrador';
    }
    function allowed(sections) {
      return active() && (admin() || userData().enabledSections.hasAny(sections));
    }
    function firstAdminAfterWrite() {
      return signedIn()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }

    match /settings/main {
      allow read: if allowed(['settings']);
      allow create: if signedIn() && !exists(/databases/$(database)/documents/settings/main) && firstAdminAfterWrite();
      allow update: if allowed(['settings']);
      allow delete: if admin();
    }

    match /publicSettings/main {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/publicSettings/main) && firstAdminAfterWrite();
      allow update: if allowed(['settings']);
      allow delete: if admin();
    }

    match /users/{uid} {
      allow create: if admin() || (
        signedIn()
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/settings/main)
        && request.resource.data.role == 'Administrador'
      );
      allow read: if active() && (uid == request.auth.uid || admin());
      allow update, delete: if admin();
    }

    match /services/{id} {
      allow read: if true;
      allow create, update, delete: if allowed(['settings']);
    }

    match /appointments/{id} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'scheduled'
        && request.resource.data.seen == false
        && request.resource.data.clientName is string
        && request.resource.data.phone is string;
      allow read: if allowed(['agenda']); // MODIFICADO: eliminado permiso exclusivo de Calendario.
      allow update, delete: if allowed(['agenda']);
    }

    match /appointmentSlots/{id} {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/appointmentSlots/$(id))
        && (request.resource.data.ownerUid == request.auth.uid || allowed(['agenda']));
      allow update, delete: if allowed(['agenda']);
    }

    match /purchases/{id} {
      allow read: if allowed(['purchaseEntry', 'purchaseHistory', 'inventory', 'products', 'dashboard']);
      allow create: if allowed(['purchaseEntry']);
      allow update, delete: if allowed(['purchaseHistory']);
    }

    match /inventory/{id} {
      allow read: if allowed(['inventory', 'products', 'billing', 'agenda', 'dashboard', 'sales']); // MODIFICADO: eliminado Cartera.
      allow create, update: if allowed(['purchaseEntry', 'inventory', 'products', 'billing', 'agenda', 'sales']); // MODIFICADO: eliminado Cartera.
      allow delete: if allowed(['inventory', 'products']);
    }

    match /products/{id} {
      allow read: if allowed(['products', 'inventory', 'billing', 'agenda', 'dashboard', 'sales']); // MODIFICADO: eliminado Cartera.
      allow create, update: if allowed(['purchaseEntry', 'products']);
      allow delete: if allowed(['products', 'inventory']);
    }

    match /expenses/{id} {
      allow read: if allowed(['expenseEntry', 'expenseHistory', 'dashboard']);
      allow create: if allowed(['expenseEntry']);
      allow update, delete: if allowed(['expenseHistory']);
    }

    match /sales/{id} {
      allow read: if allowed(['sales', 'dashboard', 'clients']);
      allow create: if allowed(['billing', 'agenda']); // MODIFICADO: ventas ya no se originan desde Cartera.
      allow update: if admin();
      allow delete: if admin();
    }

    // ELIMINADO: reglas exclusivas de la colección funcional de Cartera.

    match /clients/{id} {
      allow read: if allowed(['clients', 'billing', 'agenda', 'dashboard']);
      allow create, update: if allowed(['clients', 'billing', 'agenda']);
      allow delete: if allowed(['clients']);
    }

    match /clientStatuses/{id} {
      allow read: if allowed(['clients']);
      allow create, update, delete: if allowed(['clients']);
    }

    match /counters/{id} {
      allow read, create, update: if allowed(['purchaseEntry', 'billing', 'agenda']); // MODIFICADO: eliminado Cartera.
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

