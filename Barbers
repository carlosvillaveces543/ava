function authView(mode='login'){
  const root=$('#authRoot');root.classList.remove('hidden');$('#appRoot').classList.add('hidden');
  const setup=mode==='setup';
  root.innerHTML=`<div class="auth-shell"><div class="auth-card">
    <div class="brand"><div class="brand-mark">A</div><div><h1>AVA</h1><small>Gestión para barberías</small></div></div>
    <h2>${setup?'Crear administrador inicial':'Bienvenido de nuevo'}</h2>
    <p>${setup?'Úsalo solo para la primera configuración del sistema.':'Ingresa a tu panel de trabajo.'}</p>
    <form id="authForm">
      ${setup?`<div class="field"><label>Nombre completo</label><input id="authName" required autocomplete="name" placeholder="Administrador principal"></div>`:''}
      <div class="field"><label>Correo</label><input id="authEmail" type="email" required autocomplete="email" placeholder="admin@barberia.com"></div>
      <div class="field"><label>Contraseña</label><input id="authPassword" type="password" required minlength="6" autocomplete="${setup?'new-password':'current-password'}" placeholder="Mínimo 6 caracteres"></div>
      ${setup?`<div class="field"><label>Clave inicial</label><input id="setupKey" type="password" required placeholder="Clave de instalación"></div>`:''}
      <button class="btn btn-primary btn-block" type="submit">${setup?'Crear cuenta y configurar':'Ingresar'}</button>
    </form>
    <div class="auth-alt"><button class="link-btn" id="switchAuth">${setup?'Ya tengo una cuenta':'Configurar primer administrador'}</button></div>
  </div></div>`;
  $('#switchAuth').onclick=()=>authView(setup?'login':'setup');
  $('#authForm').onsubmit=async e=>{
    e.preventDefault();const btn=$('button[type=submit]',e.currentTarget);btn.disabled=true;
    try{
      if(setup){
        if(val('#setupKey')!=='avaadmin10')throw new Error('La clave inicial no es correcta.');
        const cred=await createUserWithEmailAndPassword(auth,val('#authEmail'),val('#authPassword'));
        const settingsRef=doc(db,'settings','main');
        await runTransaction(db,async tx=>{
          const s=await tx.get(settingsRef);if(s.exists())throw new Error('El sistema ya fue inicializado. Ingresa con una cuenta existente.');
          tx.set(doc(db,'users',cred.user.uid),{name:val('#authName'),email:val('#authEmail').toLowerCase(),role:'Administrador',enabledSections:ALL_SECTIONS,menuOrder:DEFAULT_ORDER,active:true,createdAt:serverTimestamp(),updatedAt:serverTimestamp()});
