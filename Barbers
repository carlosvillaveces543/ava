      const savedOrder=(state.profile?.menuOrder||[]).filter(id=>NAV_ITEMS.some(n=>n.id===id));
      const order=[...savedOrder,...ALL_PERMISSIONS.filter(id=>!savedOrder.includes(id))];
      return order.map(id=>NAV_ITEMS.find(n=>n.id===id)).filter(Boolean).filter(n=>allowed.includes(n.id)).filter(n=>!n.requiresProducts||state.config.catalog.sellsProducts);
    }
    function hasAccess(id){ return availableNav().some(n=>n.id===id); }
    function navItem(id){ return NAV_ITEMS.find(n=>n.id===id)||NAV_ITEMS[0]; }

    function renderNavigation(){
      const nav=availableNav(); let currentSection=""; let html="";
      for(const item of nav){ if(item.section!==currentSection){currentSection=item.section;html+=`<div class="nav-section-label">${esc(currentSection)}</div>`} html+=`<button class="nav-btn ${state.activeView===item.id?"active":""}" data-nav="${item.id}">${icon(item.icon)}<span>${esc(item.label)}</span>${item.badge&&state.notificationCount?`<span class="nav-badge">${state.notificationCount}</span>`:""}</button>`; }
      $("#sidebarNav").innerHTML=html;
      $$('[data-nav]',$("#sidebarNav")).forEach(b=>b.onclick=()=>navigate(b.dataset.nav));
      const quick=["dashboard","appointments","billing","sales"].map(id=>nav.find(n=>n.id===id)).filter(Boolean).slice(0,4);
      const bottom=[...quick,{id:"more",label:"Menú",icon:"menu"}];
