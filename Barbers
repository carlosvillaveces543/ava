const renderers={};
async function navigate(id,force=false){
  if(!SECTION_META[id]||!hasSection(id)||(!productsEnabled()&&['inventory','products'].includes(id)))id='dashboard';
  state.activeSection=id;localStorage.setItem('ava-last-section',id);closeMenu();
  $$('[data-nav]').forEach(b=>b.classList.toggle('active',b.dataset.nav===id));
  $('#topTitle').textContent=SECTION_META[id].label;
  const main=$('#main');main.innerHTML=`<div class="card center"><div class="loader" style="margin:auto"></div><p class="muted">Cargando ${esc(SECTION_META[id].label)}…</p></div>`;
  try{await renderers[id](main);state.rendered.add(id)}catch(e){console.error(e);main.innerHTML=`<div class="card"><h3>No se pudo cargar</h3><p class="danger">${esc(errorText(e))}</p><button class="btn btn-secondary" id="retryRender">Reintentar</button></div>`;$('#retryRender').onclick=()=>navigate(id,true)}
