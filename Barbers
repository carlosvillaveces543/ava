  const renderClientSales=()=>{const term=normalizeName(val('#clientSalesSearch')),from=val('#csFrom'),to=val('#csTo');const rows=sales.filter(x=>dateRangeOk(x.dateKey,from,to)&&(!term||normalizeName(`${x.clientName} ${x.phone}`).includes(term)));$('#clientSalesTotal').textContent=money(rows.reduce((s,x)=>s+num(x.total),0),2);$('#clientSalesList').innerHTML=rows.length?`<div class="responsive-list">${rows.map(x=>`<div class="list-card"><div class="list-head"><div><h4>${esc(x.clientName||'General')}</h4><p>${esc(x.phone||'')} · Factura #${x.invoiceNo}<br>${(x.items||[]).map(i=>esc(i.name)).join(', ')}</p></div><b>${money(x.total,2)}</b></div></div>`).join('')}</div>`:empty('No hay ventas para esos filtros.')};
  ['#clientSalesSearch','#csFrom','#csTo'].forEach(id=>$(id).addEventListener(id==='#clientSalesSearch'?'input':'change',renderClientSales));renderClientSales();
};
async function editClient(client){
  await modal({title:'Editar cliente',body:`<div class="field"><label>Nombre</label><input id="editClientName" value="${esc(client.name)}"></div><div class="field"><label>Celular</label><input id="editClientPhone" inputmode="tel" value="${esc(client.phone||'')}"></div><div class="field"><label>Estado</label><select id="editClientStatus"><option>General</option>${state.caches.statuses.map(x=>`<option ${x.name===client.status?'selected':''}>${esc(x.name)}</option>`).join('')}</select></div><div class="field"><label>Nota</label><textarea id="editClientNote">${esc(client.note||'')}</textarea></div>`,confirmText:'Guardar cambios',onConfirm:async root=>{const name=val('#editClientName',root);if(!name)return false;await updateDoc(doc(db,'clients',client.id),{name,normalizedName:normalizeName(name),phone:safePhone(val('#editClientPhone',root)),status:val('#editClientStatus',root)||'General',note:val('#editClientNote',root),updatedAt:serverTimestamp()});toast('Cliente actualizado.');setTimeout(()=>navigate('clients',true),0)}})
}

renderers.dashboard=async root=>{
  const [sales,purchases,expenses,clients]=await Promise.all([
    getCollection('sales',[orderBy('createdAt','desc')]),getCollection('purchases',[orderBy('createdAt','desc')]),getCollection('expenses',[orderBy('createdAt','desc')]),getCollection('clients')
  ]);state.caches.sales=sales;state.caches.purchases=purchases;state.caches.expenses=expenses;state.caches.clients=clients;
  root.innerHTML=`${pageHead('Dashboard','Resumen financiero y comercial')}${filterCard(`${rangeFields('df')}<button class="btn btn-secondary" id="dashboardToday">Hoy</button><button class="btn btn-secondary" id="dashboardMonth">Este mes</button>`)}<div id="dashboardContent"></div>`;
  const apply=()=>renderDashboardData(sales,purchases,expenses,val('#dfFrom'),val('#dfTo'));
  $('#dfFrom').onchange=apply;$('#dfTo').onchange=apply;$('#dashboardToday').onclick=()=>{$('#dfFrom').value=$('#dfTo').value=dateKey();apply()};$('#dashboardMonth').onclick=()=>{$('#dfFrom').value=`${currentMonthKey()}-01`;$('#dfTo').value=dateKey();apply()};apply();
};
function renderDashboardData(sales,purchases,expenses,from,to){
  const fs=sales.filter(x=>dateRangeOk(x.dateKey,from,to)),fp=purchases.filter(x=>dateRangeOk(x.dateKey,from,to)),fe=expenses.filter(x=>dateRangeOk(x.dateKey,from,to));
  const salesTotal=fs.reduce((s,x)=>s+num(x.total),0),purchaseTotal=fp.reduce((s,x)=>s+num(x.totalValue),0),expenseTotal=fe.reduce((s,x)=>s+num(x.value),0),net=salesTotal-purchaseTotal-expenseTotal;
  const services=new Map(),products=new Map(),customers=new Map(),payments=new Map();let productCost=0,productRevenue=0;
  fs.forEach(s=>{customers.set(s.clientName||'General',(customers.get(s.clientName||'General')||0)+num(s.total));(s.items||[]).forEach(i=>{const map=i.kind==='product'?products:services;const prev=map.get(i.name)||{qty:0,value:0};prev.qty+=num(i.quantity);prev.value+=num(i.total);map.set(i.name,prev);if(i.kind==='product'){productCost+=num(i.unitCost)*num(i.quantity);productRevenue+=num(i.total)}});(s.payments||[]).forEach(p=>payments.set(paymentLabel(p.method),(payments.get(paymentLabel(p.method))||0)+num(p.amount)))});
  const monthlySales=sales.filter(x=>x.dateKey?.startsWith(currentMonthKey())).reduce((s,x)=>s+num(x.total),0),goal=Math.max(1,num(state.settings?.monthlyGoal)||1),progress=Math.min(100,monthlySales/goal*100),productProfit=productRevenue-productCost,productPct=productRevenue>0?productProfit/productRevenue*100:0;
  $('#dashboardContent').innerHTML=`<div class="grid grid-4 mb"><div class="card stat"><div class="k">Ventas</div><div class="v success">${money(salesTotal,2)}</div><div class="hint">${fs.length} registros pagados</div></div><div class="card stat"><div class="k">Compras</div><div class="v">${money(purchaseTotal,2)}</div><div class="hint">Inventario, insumos y activos</div></div><div class="card stat"><div class="k">Gastos</div><div class="v">${money(expenseTotal,2)}</div><div class="hint">Gastos operativos</div></div><div class="card stat"><div class="k">Utilidad neta</div><div class="v ${net>=0?'success':'danger'}">${money(net,2)}</div><div class="hint">Ventas − Compras − Gastos</div></div></div>
    <div class="grid grid-2 mb"><div class="card"><h3>Meta mensual</h3><div class="row"><strong style="font-size:24px">${money(monthlySales)}</strong><span class="muted" style="margin-left:auto">de ${money(goal)}</span></div><div class="progress mt"><span style="width:${progress}%"></span></div><p class="muted">${progress.toFixed(1)}% completado en ${formatMonth(currentMonthKey())}.</p></div>
      ${productsEnabled()?`<div class="card"><h3>Rentabilidad de productos</h3><div class="grid grid-2"><div><small class="muted">Costo vendido</small><b style="display:block">${money(productCost,2)}</b></div><div><small class="muted">Venta productos</small><b style="display:block">${money(productRevenue,2)}</b></div><div><small class="muted">Utilidad</small><b class="success" style="display:block">${money(productProfit,2)}</b></div><div><small class="muted">Margen</small><b style="display:block">${productPct.toFixed(1)}%</b></div></div></div>`:`<div class="card"><h3>Modelo de negocio</h3><p class="muted">La venta de productos está desactivada. El dashboard se concentra en servicios.</p></div>`}
    </div>
    <div class="grid grid-2 mb"><div class="card"><h3>Ranking de servicios</h3>${rankHtml(services)}</div><div class="card"><h3>Top 10 clientes</h3>${rankHtml(new Map([...customers.entries()].sort((a,b)=>b[1]-a[1]).slice(0,10).map(([k,v])=>[k,{qty:0,value:v}])))}</div></div>
    ${productsEnabled()?`<div class="card mb"><h3>Ranking de productos</h3><div class="carousel">${[...products.entries()].sort((a,b)=>b[1].value-a[1].value).map(([name,v],i)=>`<div class="card"><span class="pill pill-gold">#${i+1}</span><h4 class="mt">${esc(name)}</h4><p class="muted">${v.qty} unidades</p><b style="font-size:22px">${money(v.value,2)}</b></div>`).join('')||empty('No hay ventas de productos en el periodo.')}</div></div>`:''}
    <div class="card"><h3>Ventas por forma de pago</h3>${rankHtml(new Map([...payments.entries()].map(([k,v])=>[k,{qty:0,value:v}])))}</div>`;
}
function rankHtml(map){const rows=[...map.entries()].sort((a,b)=>num(b[1]?.value??b[1])-num(a[1]?.value??a[1]));if(!rows.length)return empty('Sin datos para el periodo.');const max=Math.max(...rows.map(x=>num(x[1]?.value??x[1])),1);return `<div class="rank">${rows.map(([name,v],i)=>{const value=num(v?.value??v),qty=num(v?.qty);return `<div class="rank-item"><b>${i+1}. ${esc(name)}</b><div class="bar"><span style="width:${value/max*100}%"></span></div><div class="right"><b>${money(value)}</b>${qty?`<small style="display:block">${qty} vendidos</small>`:''}</div></div>`}).join('')}</div>`}
function formatMonth(key){const [y,m]=key.split('-').map(Number);return new Intl.DateTimeFormat('es-CO',{month:'long',year:'numeric',timeZone:BOGOTA_TZ}).format(new Date(Date.UTC(y,m-1,15,17)))}

async function profileWithRetry(uid){
  for(let i=0;i<20;i++){const snap=await getDoc(doc(db,'users',uid));if(snap.exists())return {id:snap.id,...snap.data()};await sleep(250)}return null;
}
function cleanupListeners(){state.listeners.forEach(fn=>{try{fn()}catch{}});state.listeners=[];state.unseenAppointments=0}
function installManifest(){
  const manifest={name:'AVA · Gestión para Barberías',short_name:'AVA',start_url:location.pathname,display:'standalone',background_color:'#0f0d0b',theme_color:'#0f0d0b',icons:[]};
  const link=document.createElement('link');link.rel='manifest';link.href=`data:application/manifest+json,${encodeURIComponent(JSON.stringify(manifest))}`;document.head.append(link);
}
installManifest();
setInterval(()=>{const s=$('#topSubtitle');if(s)s.textContent=`Hora de Bogotá · ${timeKey()}`},30000);

if(PUBLIC_PATH){publicBookingApp()}
else onAuthStateChanged(auth,async user=>{
  cleanupListeners();setLoading(true);
  try{
    if(!user){state.user=null;state.profile=null;state.settings=null;authView('login');return}
    if(user.isAnonymous){await signOut(auth);authView('login');return}
    const profile=await profileWithRetry(user.uid);if(!profile||profile.active===false){toast('Esta cuenta no tiene acceso activo al sistema.','error');await signOut(auth);return}
    state.user=user;state.profile=profile;await ensureSettings();
    const last=localStorage.getItem('ava-last-section')||'dashboard';state.activeSection=hasSection(last)?last:getMenuOrder()[0]||'dashboard';
    appShell();startAppointmentListener();
  }catch(e){console.error(e);toast(errorText(e),'error');if(auth.currentUser)await signOut(auth)}finally{setLoading(false)}
});

</script>

<!--
===============================================================================
AVA — REGLAS DE SEGURIDAD SUGERIDAS PARA CLOUD FIRESTORE
Pega este bloque en Firebase Console > Firestore Database > Rules y publícalo.
Activa en Authentication los proveedores Email/Password y Anónimo.
Para producción, activa Firebase App Check y prueba estas reglas en Emulator Suite.
