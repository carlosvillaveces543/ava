function bindBookingStep(bk,s,render){
  $$('[data-service]').forEach(el=>el.onclick=()=>{bk.service=state.caches.services.find(x=>x.id===el.dataset.service);render()});
  $('#bkPeople')?.addEventListener('change',e=>bk.people=num(e.target.value));
  $('#bkDate')?.addEventListener('change',e=>{bk.date=e.target.value;const h=holidayName(bk.date);$('#holidayInfo').innerHTML=h?statusPill(h,'warning'):'';$('#bkNext').disabled=!bk.date});
  $$('[data-slot]').forEach(el=>el.onclick=()=>{bk.time=el.dataset.slot;render()});
  $('#bkBack')?.addEventListener('click',()=>{bk.step--;bk.time='';render()});
  $('#bkNext')?.addEventListener('click',async()=>{
    if(bk.step===1&&!bk.service)return;
    if(bk.step===2){
      if(!bk.date)return;
      if(s.holidayMode&&holidayName(bk.date)){toast('La barbería no recibe reservas en festivos.','error');return}
      const btn=$('#bkNext');btn.disabled=true;btn.textContent='Consultando…';bk.available=await availableSlots(bk.date,bk.people,s);bk.step++;bk.time='';render();return;
    }
    bk.step++;render();
  });
  $('#bkConfirm')?.addEventListener('click',async()=>{
    const name=val('#bkName'),phone=safePhone(val('#bkPhone'));if(!name||phone.length<7){toast('Completa tu nombre y celular.','error');return}
    const btn=$('#bkConfirm');btn.disabled=true;btn.textContent='Reservando…';
    try{
