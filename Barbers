function modal({title,body,confirmText='Confirmar',cancelText='Cancelar',danger=false,onConfirm=null,wide=false}){
  return new Promise(resolve=>{
    const root=$('#modalRoot');
    root.innerHTML=`<div class="modal-backdrop"><div class="modal ${wide?'wide':''}" role="dialog" aria-modal="true">
      <div class="modal-head"><h3>${esc(title)}</h3><button class="icon-btn close" data-close>×</button></div>
      <div class="modal-body">${body}</div>
      <div class="modal-foot"><button class="btn btn-ghost" data-close>${esc(cancelText)}</button><button class="btn ${danger?'btn-danger':'btn-primary'}" data-confirm>${esc(confirmText)}</button></div>
    </div></div>`;
    const finish=v=>{root.innerHTML='';resolve(v)};
    $$('[data-close]',root).forEach(b=>b.onclick=()=>finish(false));
    $('[data-confirm]',root).onclick=async()=>{
      const btn=$('[data-confirm]',root);btn.disabled=true;
      try{if(onConfirm){const result=await onConfirm(root);if(result===false){btn.disabled=false;return}}finish(true)}catch(e){console.error(e);toast(errorText(e),'error');btn.disabled=false}
    };
    $('.modal-backdrop',root).addEventListener('click',e=>{if(e.target.classList.contains('modal-backdrop'))finish(false)});
  });
}
async function confirmAction(message,title='Confirmar acción',danger=true){return modal({title,body:`<p class="m0">${esc(message)}</p>`,confirmText:'Sí, continuar',danger})}
function errorText(e){
  const code=e?.code||'';
  const map={
    'auth/invalid-credential':'Correo o contraseña incorrectos.','auth/email-already-in-use':'Ese correo ya está registrado.',
    'auth/weak-password':'La contraseña debe tener mínimo 6 caracteres.','auth/invalid-email':'El correo no es válido.',
    'permission-denied':'No tienes permiso para realizar esta acción.','failed-precondition':'Falta crear un índice o activar un servicio en Firebase.',
    'unavailable':'Sin conexión. La operación se sincronizará cuando vuelva internet.'
  };
  return map[code]||e?.message||'Ocurrió un error inesperado.';
}

function easterSunday(year){
  const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31),day=((h+l-7*m+114)%31)+1;
  return new Date(Date.UTC(year,month-1,day,17,0,0));
}
function mondayAfter(year,month,day){const d=new Date(Date.UTC(year,month-1,day,17));const dow=d.getUTCDay();const add=dow===1?0:(8-dow)%7;d.setUTCDate(d.getUTCDate()+add);return dateKey(d)}
function colombianHolidays(year){
  const fixed=[[1,1,'Año Nuevo'],[5,1,'Día del Trabajo'],[7,20,'Independencia'],[8,7,'Batalla de Boyacá'],[12,8,'Inmaculada Concepción'],[12,25,'Navidad']];
  const emiliani=[[1,6,'Reyes Magos'],[3,19,'San José'],[6,29,'San Pedro y San Pablo'],[8,15,'Asunción'],[10,12,'Día de la Raza'],[11,1,'Todos los Santos'],[11,11,'Independencia de Cartagena']];
  const out=new Map();fixed.forEach(([m,d,n])=>out.set(`${year}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`,n));emiliani.forEach(([m,d,n])=>out.set(mondayAfter(year,m,d),n));
  const easter=easterSunday(year);const rel=[[-3,'Jueves Santo'],[-2,'Viernes Santo'],[43,'Ascensión del Señor'],[64,'Corpus Christi'],[71,'Sagrado Corazón']];
  rel.forEach(([delta,n])=>{const d=new Date(easter);d.setUTCDate(d.getUTCDate()+delta);let key=dateKey(d);if(delta>0)key=mondayAfter(Number(key.slice(0,4)),Number(key.slice(5,7)),Number(key.slice(8,10)));out.set(key,n)});
  return out;
}
function holidayName(key){return colombianHolidays(Number(key.slice(0,4))).get(key)||''}

