function getMenuOrder(){
  const saved=[...(state.profile?.menuOrder||DEFAULT_ORDER)]; // MODIFICADO: se conserva el orden guardado existente.
  // NUEVO: administradores/perfiles autorizados antiguos reciben Horarios Disponibles sin migrar documentos de Firestore.
  if(hasSection('availability')&&!saved.includes('availability')){const agendaIndex=saved.indexOf('agenda');saved.splice(agendaIndex>=0?agendaIndex+1:saved.length,0,'availability')}
  let o=saved.filter(id=>SECTION_META[id]&&hasSection(id));
  if(!productsEnabled())o=o.filter(id=>!['inventory','products'].includes(id));
  return o.length?o:['dashboard'];
}
