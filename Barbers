      }
      tx.set(counterRef,{purchaseNo,updatedAt:serverTimestamp()},{merge:true});const groupId=randomId('purchase');
      for(const item of items){
        const pRef=doc(collection(db,'purchases'));const {id:tempId,...purchaseItem}=item;tx.set(pRef,{...purchaseItem,purchaseNo,purchaseGroupId:groupId,dateKey:dateKey(),createdAt:serverTimestamp(),createdBy:state.user.uid});
        if(item.type==='sale'){
          const key=docKey(item.description),inv=inventoryData.get(key),prod=productData.get(key),oldInv=inv.snap.data()||{},oldProd=prod.snap.data()||{};
          tx.set(inv.ref,{type:'sale',description:item.description,normalizedName:item.normalizedName,stock:round2(num(oldInv.stock)+item.quantity),unit:item.unit,unitCost:item.unitValue,updatedAt:serverTimestamp()},{merge:true});
          tx.set(prod.ref,{name:item.description,normalizedName:item.normalizedName,cost:item.unitValue,pvp:num(oldProd.pvp)||0,updatedAt:serverTimestamp(),createdAt:oldProd.createdAt||serverTimestamp()},{merge:true});
          oldInv.stock=round2(num(oldInv.stock)+item.quantity);oldInv.unitCost=item.unitValue;oldProd.cost=item.unitValue;
        }
      }
    });
    state.temp.purchase=[];toast('Compra guardada.');await navigate('purchaseEntry',true);
  }catch(e){toast(errorText(e),'error');btn.disabled=false;btn.textContent='Guardar compra completa'}
}

