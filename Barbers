    function closeModal(result=null){ const layer=$("#modalLayer"); const resolver=layer._resolver; layer.classList.remove("open"); layer.innerHTML=""; layer._resolver=null; resolver?.(result); }
    function openModal({title,subtitle="",body="",confirmText="Guardar",cancelText="Cancelar",danger=false,large=false,onConfirm=null,hideConfirm=false}){
      const layer=$("#modalLayer");
      layer.innerHTML=`<div class="modal ${large?"modal-lg":""}"><div class="modal-head"><div><h3>${esc(title)}</h3>${subtitle?`<p>${esc(subtitle)}</p>`:""}</div><button class="modal-close" data-modal-close>${icon("x")}</button></div><div class="modal-body">${body}</div><div class="modal-foot"><button class="btn btn-ghost" data-modal-close>${esc(cancelText)}</button>${hideConfirm?"":`<button class="btn ${danger?"btn-danger":"btn-primary"}" id="modalConfirm">${danger?icon("trash"):icon("check")}${esc(confirmText)}</button>`}</div></div>`;
      layer.classList.add("open"); $$('[data-modal-close]',layer).forEach(b=>b.onclick=()=>closeModal(false));
