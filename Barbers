<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0b0b0c" />
  <meta name="description" content="AVA — Gestión integral para barberías" />
  <title>AVA · Gestión para Barberías</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#09090a;--bg-2:#0f0f11;--panel:#151518;--panel-2:#1c1c20;--panel-3:#242429;
      --line:#2d2d33;--line-soft:#232328;--text:#f5f2ea;--muted:#aaa6a0;--faint:#77747a;
      --accent:#c89147;--accent-2:#e0b46d;--accent-3:#8b5d2a;--success:#5fc487;--danger:#ef6f6c;
      --warning:#e8b75c;--info:#6ca7e8;--radius:18px;--radius-sm:12px;--shadow:0 22px 60px rgba(0,0,0,.35);
      --sidebar:268px;--topbar:72px;--bottom-nav:72px;
    }
    *{box-sizing:border-box}
    html{color-scheme:dark;scroll-behavior:smooth}
    body{margin:0;min-height:100vh;background:
      radial-gradient(circle at 92% -10%,rgba(200,145,71,.14),transparent 28%),
      radial-gradient(circle at -10% 110%,rgba(200,145,71,.07),transparent 30%),var(--bg);
      color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;-webkit-font-smoothing:antialiased}
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    a{color:inherit}
    .hidden{display:none!important}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .muted{color:var(--muted)}.danger-text{color:var(--danger)}.success-text{color:var(--success)}
    .eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-2)}
    .app-loader{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;background:var(--bg);transition:opacity .25s ease}
    .loader-mark{width:74px;height:74px;border:1px solid rgba(200,145,71,.5);border-radius:24px;display:grid;place-items:center;box-shadow:0 0 55px rgba(200,145,71,.13);animation:pulse 1.3s infinite}
    .loader-mark b{font-family:Oswald;font-size:1.65rem;letter-spacing:.08em;color:var(--accent-2)}
    @keyframes pulse{50%{transform:scale(.96);opacity:.72}}

    /* Login */
    .auth-shell{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.85fr)}
    .auth-hero{position:relative;overflow:hidden;padding:clamp(34px,6vw,88px);display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line-soft)}
    .auth-hero:before{content:"";position:absolute;inset:0;background:
      linear-gradient(135deg,rgba(9,9,10,.25),rgba(9,9,10,.88)),
      repeating-linear-gradient(135deg,transparent 0 28px,rgba(255,255,255,.018) 28px 29px)}
    .auth-hero>*{position:relative;z-index:1}.brand-lockup{display:flex;align-items:center;gap:14px}
    .brand-badge{width:50px;height:50px;border:1px solid rgba(224,180,109,.5);border-radius:16px;background:linear-gradient(145deg,#20180f,#0e0e10);display:grid;place-items:center;box-shadow:inset 0 0 22px rgba(200,145,71,.08)}
    .brand-badge svg{width:26px;height:26px;color:var(--accent-2)}
    .brand-name{font-family:Oswald;font-size:1.5rem;letter-spacing:.12em}.brand-sub{font-size:.75rem;color:var(--muted);margin-top:2px}
    .auth-copy h1{font-family:Oswald;font-size:clamp(3.1rem,7vw,7.4rem);line-height:.93;letter-spacing:-.03em;margin:22px 0;max-width:900px;text-transform:uppercase}
    .auth-copy h1 span{color:var(--accent-2)}.auth-copy p{font-size:clamp(1rem,1.6vw,1.25rem);line-height:1.65;color:#c4c0b8;max-width:650px}
    .auth-proof{display:flex;gap:20px;flex-wrap:wrap}.proof-pill{display:flex;align-items:center;gap:9px;padding:10px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(18,18,20,.68);font-size:.82rem;color:#d4d0c8}
    .auth-panel{display:grid;place-items:center;padding:28px;background:linear-gradient(180deg,#0e0e10,#09090a)}
    .auth-card{width:min(100%,450px);padding:34px;border:1px solid var(--line);border-radius:26px;background:rgba(21,21,24,.92);box-shadow:var(--shadow)}
    .auth-card h2{font-family:Oswald;font-size:2.2rem;margin:7px 0}.auth-card>p{color:var(--muted);line-height:1.6;margin:0 0 25px}

    /* Forms */
    .field{display:flex;flex-direction:column;gap:8px;min-width:0}.field label{font-size:.78rem;font-weight:700;color:#d0ccc5}
    .field small{font-size:.72rem;color:var(--faint);line-height:1.4}
    input,select,textarea{width:100%;border:1px solid var(--line);border-radius:12px;background:#101012;color:var(--text);padding:12px 13px;outline:none;transition:.18s;border-color .18s,box-shadow .18s,background .18s}
    input:focus,select:focus,textarea:focus{border-color:rgba(224,180,109,.7);box-shadow:0 0 0 3px rgba(200,145,71,.12);background:#131315}
    input[readonly]{color:#bdb8ae;background:#0c0c0e}.input-prefix{position:relative}.input-prefix span{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:700}.input-prefix input{padding-left:31px}
    textarea{min-height:96px;resize:vertical}.form-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}.col-12{grid-column:span 12}.col-8{grid-column:span 8}.col-6{grid-column:span 6}.col-4{grid-column:span 4}.col-3{grid-column:span 3}.col-2{grid-column:span 2}
    .form-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;margin-top:18px}
    .btn{border:1px solid transparent;border-radius:12px;padding:11px 15px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;transition:transform .16s,filter .16s,background .16s,border .16s;line-height:1}
    .btn:hover{transform:translateY(-1px);filter:brightness(1.06)}.btn:active{transform:translateY(0)}.btn svg{width:18px;height:18px}
    .btn-primary{background:linear-gradient(135deg,var(--accent-2),var(--accent));color:#15100a;box-shadow:0 10px 30px rgba(200,145,71,.18)}
    .btn-secondary{background:var(--panel-3);border-color:var(--line);color:var(--text)}.btn-ghost{background:transparent;border-color:var(--line);color:#d9d5ce}.btn-danger{background:rgba(239,111,108,.12);border-color:rgba(239,111,108,.3);color:#ff9895}.btn-success{background:rgba(95,196,135,.13);border-color:rgba(95,196,135,.3);color:#87dca8}.btn-sm{padding:8px 10px;min-height:34px;font-size:.78rem;border-radius:10px}.btn-icon{width:38px;padding:0}
    .switch-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px;border:1px solid var(--line-soft);border-radius:14px;background:#111113}.switch-copy b{display:block;font-size:.88rem}.switch-copy span{display:block;color:var(--muted);font-size:.74rem;margin-top:4px;line-height:1.4}
    .switch{position:relative;width:48px;height:27px;flex:0 0 auto}.switch input{opacity:0;width:0;height:0}.switch-slider{position:absolute;inset:0;border-radius:999px;background:#303038;transition:.2s}.switch-slider:before{content:"";position:absolute;width:21px;height:21px;left:3px;top:3px;border-radius:50%;background:#ddd;transition:.2s}.switch input:checked+.switch-slider{background:var(--accent)}.switch input:checked+.switch-slider:before{transform:translateX(21px);background:#15100a}
    .check-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.check-item{display:flex;align-items:center;gap:9px;padding:10px;border:1px solid var(--line-soft);border-radius:11px;background:#101012;font-size:.8rem}.check-item input{width:auto;accent-color:var(--accent)}

    /* App shell */
    .app-shell{min-height:100vh;padding-left:var(--sidebar)}
    .sidebar{position:fixed;z-index:80;left:0;top:0;bottom:0;width:var(--sidebar);display:flex;flex-direction:column;background:rgba(13,13,15,.96);backdrop-filter:blur(18px);border-right:1px solid var(--line-soft);padding:20px 14px}
    .sidebar-brand{padding:6px 10px 22px}.sidebar-nav{flex:1;overflow:auto;padding-right:4px}.sidebar-nav::-webkit-scrollbar{width:4px}.sidebar-nav::-webkit-scrollbar-thumb{background:#34343a;border-radius:5px}
    .nav-section-label{padding:15px 12px 8px;color:#66636a;font-size:.64rem;letter-spacing:.14em;font-weight:800;text-transform:uppercase}
    .nav-btn{width:100%;display:flex;align-items:center;gap:12px;border:1px solid transparent;background:transparent;color:#aaa7aa;border-radius:12px;padding:11px 12px;margin:2px 0;text-align:left;font-weight:650;font-size:.85rem;position:relative}
    .nav-btn svg{width:19px;height:19px;flex:0 0 auto}.nav-btn:hover{background:#19191c;color:#eee}.nav-btn.active{background:linear-gradient(90deg,rgba(200,145,71,.19),rgba(200,145,71,.04));border-color:rgba(200,145,71,.19);color:var(--accent-2)}
    .nav-badge{margin-left:auto;min-width:21px;height:21px;padding:0 6px;border-radius:999px;background:var(--danger);color:white;display:grid;place-items:center;font-size:.68rem;font-weight:900}
    .sidebar-user{border-top:1px solid var(--line-soft);padding:14px 7px 0}.user-mini{display:flex;align-items:center;gap:10px}.avatar{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--accent-3),#2a2117);display:grid;place-items:center;font-weight:900;color:var(--accent-2);border:1px solid rgba(224,180,109,.2)}
    .user-meta{min-width:0;flex:1}.user-meta b,.user-meta span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.user-meta b{font-size:.78rem}.user-meta span{font-size:.67rem;color:var(--muted);margin-top:3px}
    .topbar{position:sticky;z-index:60;top:0;height:var(--topbar);display:flex;align-items:center;justify-content:space-between;padding:0 clamp(18px,3vw,38px);background:rgba(9,9,10,.82);backdrop-filter:blur(16px);border-bottom:1px solid rgba(45,45,51,.7)}
    .topbar-title h1{font-family:Oswald;font-size:1.45rem;letter-spacing:.03em;margin:0}.topbar-title p{font-size:.72rem;color:var(--muted);margin:3px 0 0}.topbar-actions{display:flex;align-items:center;gap:10px}.live-clock{padding:9px 12px;border:1px solid var(--line);border-radius:11px;background:#111113;font-size:.74rem;color:#cbc7c0}
    .mobile-menu-btn{display:none}.main{padding:clamp(18px,3vw,38px);max-width:1680px;margin:0 auto}.bottom-nav{display:none}

    /* Layout & cards */
    .page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:24px}.page-head h2{font-family:Oswald;font-size:clamp(1.9rem,3vw,2.7rem);letter-spacing:.01em;margin:5px 0}.page-head p{color:var(--muted);max-width:720px;line-height:1.6;margin:0;font-size:.88rem}.page-actions{display:flex;gap:10px;flex-wrap:wrap}
    .grid{display:grid;gap:18px}.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}
    .card{border:1px solid var(--line-soft);background:linear-gradient(180deg,rgba(23,23,26,.98),rgba(18,18,20,.98));border-radius:var(--radius);padding:20px;box-shadow:0 8px 26px rgba(0,0,0,.12);min-width:0}.card-accent{border-color:rgba(200,145,71,.28);background:linear-gradient(145deg,rgba(200,145,71,.09),rgba(20,20,23,.98) 42%)}
    .card-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.card-title{font-size:.92rem;font-weight:850;margin:0}.card-sub{font-size:.73rem;color:var(--muted);margin-top:4px;line-height:1.45}.card-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:rgba(200,145,71,.1);color:var(--accent-2);border:1px solid rgba(200,145,71,.15)}.card-icon svg{width:20px;height:20px}
    .metric{padding:19px;border:1px solid var(--line-soft);border-radius:16px;background:#111113;min-width:0}.metric-label{font-size:.71rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}.metric-value{font-family:Oswald;font-size:clamp(1.6rem,3vw,2.35rem);margin-top:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metric-foot{font-size:.7rem;color:var(--faint);margin-top:6px}
    .section-stack{display:flex;flex-direction:column;gap:18px}.section-divider{height:1px;background:var(--line-soft);margin:20px 0}.subheading{font-family:Oswald;font-size:1.35rem;margin:0 0 4px}.inline-note{padding:12px 14px;border:1px solid rgba(108,167,232,.24);background:rgba(108,167,232,.08);border-radius:12px;font-size:.77rem;color:#bdd8f7;line-height:1.5}
    .empty{padding:36px 18px;text-align:center;border:1px dashed #36363c;border-radius:15px;color:var(--muted)}.empty svg{width:36px;height:36px;color:#5b5860;margin-bottom:9px}.empty b{display:block;color:#d4d0c8;margin-bottom:5px}.empty span{font-size:.78rem;line-height:1.5}
    .filters{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:12px;padding:14px;border:1px solid var(--line-soft);border-radius:15px;background:#111113;margin-bottom:18px}.filter-actions{display:flex;align-items:end;gap:8px}

    /* Tables */
    .table-wrap{overflow:auto;border:1px solid var(--line-soft);border-radius:15px}.data-table{width:100%;border-collapse:collapse;min-width:760px}.data-table th{position:sticky;top:0;background:#111113;color:#88858d;font-size:.67rem;letter-spacing:.08em;text-transform:uppercase;text-align:left;padding:12px 14px;border-bottom:1px solid var(--line)}.data-table td{padding:13px 14px;border-bottom:1px solid var(--line-soft);font-size:.8rem;color:#d9d5ce;vertical-align:middle}.data-table tbody tr:hover{background:rgba(255,255,255,.018)}.data-table tbody tr:last-child td{border-bottom:0}.table-actions{display:flex;gap:7px;white-space:nowrap}.cell-main{font-weight:750;color:#f1eee7}.cell-sub{font-size:.68rem;color:var(--muted);margin-top:4px}.numeric{text-align:right;font-variant-numeric:tabular-nums}.tag{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;border:1px solid var(--line);background:#19191c;color:#c7c3bd;font-size:.68rem;font-weight:750}.tag-gold{border-color:rgba(200,145,71,.28);background:rgba(200,145,71,.1);color:var(--accent-2)}.tag-green{border-color:rgba(95,196,135,.25);background:rgba(95,196,135,.09);color:#83dca6}.tag-red{border-color:rgba(239,111,108,.28);background:rgba(239,111,108,.09);color:#ff9895}.tag-blue{border-color:rgba(108,167,232,.25);background:rgba(108,167,232,.09);color:#9bc5f4}
    .draft-total{display:flex;justify-content:flex-end;align-items:center;gap:14px;padding:16px 4px 0}.draft-total span{color:var(--muted);font-size:.8rem}.draft-total b{font-family:Oswald;font-size:1.65rem;color:var(--accent-2)}

    /* Dashboard */
    .profit-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.profit-main{position:relative;overflow:hidden;min-height:220px;display:flex;flex-direction:column;justify-content:space-between}.profit-main:after{content:"";position:absolute;width:250px;height:250px;border:1px solid rgba(224,180,109,.12);border-radius:50%;right:-80px;top:-90px;box-shadow:0 0 0 35px rgba(224,180,109,.025),0 0 0 70px rgba(224,180,109,.018)}.profit-main>*{position:relative;z-index:1}.profit-number{font-family:Oswald;font-size:clamp(2.7rem,6vw,5.3rem);line-height:1;margin:12px 0}.equation{display:flex;gap:8px;flex-wrap:wrap}.equation span{padding:7px 9px;border-radius:9px;background:#111113;border:1px solid var(--line-soft);font-size:.7rem;color:#bcb8b1}.progress-track{height:12px;border-radius:999px;background:#0d0d0f;border:1px solid var(--line);overflow:hidden}.progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--accent-3),var(--accent-2));border-radius:inherit;transition:width .4s ease}.rank-list{display:flex;flex-direction:column;gap:9px}.rank-row{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px;border:1px solid var(--line-soft);border-radius:12px;background:#111113}.rank-index{width:28px;height:28px;border-radius:9px;background:#1e1e22;display:grid;place-items:center;font-family:Oswald;color:var(--accent-2)}.rank-name{font-size:.77rem;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rank-value{font-size:.74rem;color:#d4d0c8;font-weight:800}.bar-row{display:grid;grid-template-columns:115px minmax(80px,1fr) auto;gap:10px;align-items:center;margin:11px 0}.bar-label{font-size:.72rem;color:#bbb7b0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bar-track{height:8px;border-radius:99px;background:#0d0d0f;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,var(--accent-3),var(--accent-2));border-radius:inherit}.bar-value{font-size:.69rem;color:var(--muted)}

    /* Agenda // MODIFICADO: se elimina el CSS exclusivo del Calendario mensual */
    .appointment-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.appointment-card{position:relative;overflow:hidden;border:1px solid var(--line-soft);border-radius:17px;padding:17px;background:#141416}.appointment-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--day-color,var(--accent))}.appointment-top{display:flex;justify-content:space-between;gap:12px}.appointment-time{font-family:Oswald;font-size:1.45rem;color:var(--day-color,var(--accent-2))}.appointment-date{font-size:.68rem;color:var(--muted);margin-top:3px}.appointment-name{font-size:1rem;font-weight:850;margin:14px 0 4px}.appointment-service{font-size:.76rem;color:#c1bdb5}.appointment-meta{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}.appointment-actions{display:flex;gap:7px;flex-wrap:wrap;padding-top:12px;border-top:1px solid var(--line-soft)}
    /* // ELIMINADO: .calendar-shell, .calendar-grid, .calendar-day y estilos asociados */

    /* Public booking */
    .public-shell{min-height:100vh;padding:18px;background:
      radial-gradient(circle at 50% -15%,rgba(200,145,71,.2),transparent 32%),
      linear-gradient(180deg,#09090a,#0e0e10)}
    .public-wrap{width:min(100%,760px);margin:0 auto;padding:20px 0 60px}.public-brand{display:flex;align-items:center;justify-content:center;gap:11px;margin:12px 0 36px}.public-hero{text-align:center;margin-bottom:28px}.public-hero h1{font-family:Oswald;font-size:clamp(2.4rem,8vw,4.5rem);line-height:1.02;text-transform:uppercase;margin:8px 0 13px}.public-hero h1 span{color:var(--accent-2)}.public-hero p{color:var(--muted);line-height:1.6;max-width:580px;margin:0 auto}.booking-card{padding:clamp(18px,4vw,30px);border:1px solid rgba(200,145,71,.24);border-radius:24px;background:rgba(20,20,23,.96);box-shadow:var(--shadow)}
    .step{display:none;animation:fade .22s ease}.step.active{display:block}@keyframes fade{from{opacity:0;transform:translateY(6px)}}.step-head{margin-bottom:20px}.step-head span{color:var(--accent-2);font-size:.7rem;font-weight:900;letter-spacing:.14em}.step-head h2{font-family:Oswald;font-size:1.75rem;margin:6px 0}.option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.option-card{border:1px solid var(--line);background:#111113;border-radius:14px;padding:15px;text-align:left;color:var(--text);transition:.18s}.option-card:hover,.option-card.selected{border-color:rgba(224,180,109,.7);background:rgba(200,145,71,.1)}.option-card b{display:block;font-size:.86rem}.option-card span{display:block;color:var(--muted);font-size:.7rem;margin-top:6px}.people-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(66px,1fr));gap:9px}.people-btn,.time-btn,.date-btn{border:1px solid var(--line);background:#111113;color:#d8d4cd;border-radius:12px;padding:12px 9px;font-weight:800}.people-btn.selected,.time-btn.selected,.date-btn.selected{background:var(--accent);color:#17110a;border-color:var(--accent-2)}.date-scroller{display:flex;gap:8px;overflow:auto;padding-bottom:8px}.date-btn{min-width:88px}.date-btn span{display:block;font-size:.65rem;font-weight:600;margin-top:4px;opacity:.75}.time-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.booking-nav{display:flex;justify-content:space-between;gap:10px;margin-top:24px}.step-dots{display:flex;justify-content:center;gap:7px;margin-bottom:20px}.step-dot{width:7px;height:7px;border-radius:50%;background:#3a393f}.step-dot.active{width:22px;border-radius:99px;background:var(--accent)}.booking-confirm{text-align:center;padding:20px 0}.confirm-icon{width:68px;height:68px;border-radius:22px;display:grid;place-items:center;background:rgba(95,196,135,.12);color:var(--success);margin:0 auto 18px;border:1px solid rgba(95,196,135,.25)}.confirm-icon svg{width:34px;height:34px}.absence-note{margin-top:18px;padding:14px;border:1px solid rgba(232,183,92,.23);background:rgba(232,183,92,.08);border-radius:13px;color:#e5ca95;font-size:.76rem;line-height:1.55}

    /* Modal & toast */
