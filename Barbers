      const clientMap=new Map();for(const s of sales){const key=s.client?.id||phoneDigits(s.client?.phone)||normalize(s.client?.name||"General"),x=clientMap.get(key)||{name:s.client?.name||"General",phone:s.client?.phone||"",total:0};x.total+=s.total||0;clientMap.set(key,x)}const topClients=[...clientMap.values()].sort((a,b)=>b.total-a.total).slice(0,10),payMap=new Map();for(const s of sales)for(const p of s.paymentDetails||[])payMap.set(p.method,(payMap.get(p.method)||0)+(p.amount||0));const payments=[...payMap.entries()].map(([name,total])=>({name,total})).sort((a,b)=>b.total-a.total),maxPay=Math.max(1,...payments.map(x=>x.total));
      // MODIFICADO: el Dashboard ya no referencia cuentas pendientes de Cartera.
      $("#dashboardContent").innerHTML=`<div class="section-stack"><div class="profit-hero"><div class="card card-accent profit-main"><div><div class="eyebrow">Utilidad neta del rango</div><div class="profit-number ${net>=0?"success-text":"danger-text"}">${money(net)}</div><div class="equation"><span>Servicios ${money(serviceRevenue)}</span><span>+ Productos ${money(productRevenue)}</span><span>− Compras ${money(purchaseTotal)}</span><span>− Gastos ${money(expenseTotal)}</span></div></div><div class="cell-sub">Solo incluye ventas cerradas registradas en el sistema.</div></div><div class="card"><div class="card-head"><div><h3 class="card-title">Meta del mes</h3><div class="card-sub">Ventas cerradas del mes actual.</div></div><div class="card-icon">${icon("chart")}</div></div><div class="metric-value">${money(monthRevenue)}</div><div class="progress-track" style="margin:13px 0"><div class="progress-fill" style="width:${progress}%"></div></div><div style="display:flex;justify-content:space-between;gap:10px"><span class="cell-sub">${numberCO(progress)}% de ${money(goal)}</span><button id="editMonthlyGoal" class="btn btn-ghost btn-sm">${icon("edit")} Cambiar meta</button></div></div></div>
      <div class="grid grid-4"><div class="metric"><div class="metric-label">Ventas totales</div><div class="metric-value">${money(serviceRevenue+productRevenue)}</div><div class="metric-foot">${sales.length} facturas cerradas</div></div><div class="metric"><div class="metric-label">Compras</div><div class="metric-value">${money(purchaseTotal)}</div><div class="metric-foot">${purchases.length} comprobantes</div></div><div class="metric"><div class="metric-label">Gastos</div><div class="metric-value">${money(expenseTotal)}</div><div class="metric-foot">${expenses.length} registros</div></div><div class="metric"><div class="metric-label">Ticket promedio</div><div class="metric-value">${money(sales.length?(serviceRevenue+productRevenue)/sales.length:0)}</div><div class="metric-foot">Promedio por factura</div></div></div>
      ${state.config.catalog.sellsProducts?`<div class="grid grid-4"><div class="metric"><div class="metric-label">Costo productos vendidos</div><div class="metric-value">${money(productCost)}</div></div><div class="metric"><div class="metric-label">Venta de productos</div><div class="metric-value">${money(productRevenue)}</div></div><div class="metric"><div class="metric-label">Utilidad productos</div><div class="metric-value ${productProfit>=0?"success-text":"danger-text"}">${money(productProfit)}</div></div><div class="metric"><div class="metric-label">Margen productos</div><div class="metric-value ${productPct>=0?"success-text":"danger-text"}">${numberCO(productPct)}%</div></div></div>`:""}
      <div class="grid grid-2"><div class="card"><div class="card-head"><div><h3 class="card-title">Ranking de servicios</h3><div class="card-sub">Ordenado por valor vendido.</div></div></div>${rankHtml(serviceRank,"No hay servicios vendidos")}</div>${state.config.catalog.sellsProducts?`<div class="card"><div class="card-head"><div><h3 class="card-title">Ranking de productos</h3><div class="card-sub">Contenedor desplazable para catálogos extensos.</div></div></div><div style="max-height:390px;overflow:auto">${rankHtml(productRank,"No hay productos vendidos")}</div></div>`:`<div class="card"><div class="card-head"><div><h3 class="card-title">Desglose por forma de pago</h3></div></div>${paymentHtml(payments,maxPay)}</div>`}</div>
      <div class="grid grid-2"><div class="card"><div class="card-head"><div><h3 class="card-title">Top 10 clientes</h3><div class="card-sub">Por valor de compra dentro del rango.</div></div></div>${rankHtml(topClients,"No hay clientes con ventas")}</div><div class="card"><div class="card-head"><div><h3 class="card-title">Formas de pago</h3><div class="card-sub">Incluye pagos divididos.</div></div></div>${paymentHtml(payments,maxPay)}</div></div></div>`;
      $("#editMonthlyGoal").onclick=async()=>{const value=await promptModal({title:"Meta del mes",subtitle:"Define el objetivo de ventas cerradas para el mes actual.",label:"Valor en COP",type:"number",value:String(goal),confirmText:"Guardar meta"});if(value===false)return;try{await setDoc(doc(db,"config","main"),{dashboard:{monthlyGoal:round2(value)},updatedAt:serverTimestamp()},{merge:true});toast("Meta actualizada")}catch(err){toast("No se pudo actualizar","error",firebaseMessage(err))}};
    }
    function rankHtml(data,emptyText){if(!data.length)return emptyState(emptyText,"Los datos aparecerán cuando existan ventas cerradas.","chart");return `<div class="rank-list">${data.map((x,i)=>`<div class="rank-row"><div class="rank-index">${i+1}</div><div><div class="rank-name">${esc(x.name)}</div><div class="cell-sub">${x.phone?esc(x.phone):x.quantity?`${numberCO(x.quantity)} unidades`:""}</div></div><div class="rank-value">${money(x.total)}</div></div>`).join("")}</div>`}
    function paymentHtml(data,max){if(!data.length)return emptyState("Sin pagos registrados","El desglose aparecerá con las ventas.","wallet");return data.map(x=>`<div class="bar-row"><div class="bar-label">${esc(x.name)}</div><div class="bar-track"><div class="bar-fill" style="width:${x.total/max*100}%"></div></div><div class="bar-value">${money(x.total)}</div></div>`).join("")}

    /* =========================================================
       Reglas de Firestore incluidas para copiar desde Configuración
       ========================================================= */
    const FIRESTORE_RULES = String.raw`rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return profileExists() && profile().active == true;
    }

    function admin() {
      return active() && profile().role == 'Administrador';
    }

    function canAny(modules) {
      return active() && (admin() || profile().permissions.hasAny(modules));
    }

    function publicAppointmentIsValid() {
      return request.auth == null
        && request.resource.data.keys().hasOnly([
          'clientName','clientPhone','serviceId','serviceName','servicePrice','people',
          'date','startMinute','endMinute','startAt','endAt','duration','slotIds',
          'status','source','createdAt'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 120
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.size() >= 7
        && request.resource.data.clientPhone.size() <= 30
        && request.resource.data.people is int
        && request.resource.data.people >= 1
        && request.resource.data.people <= 10
        && request.resource.data.status == 'scheduled'
        && request.resource.data.source == 'public'
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId));
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/config/main)
        && request.resource.data.role == 'Administrador';
      allow read: if active() && (request.auth.uid == uid || admin());
      allow update: if admin()
        || (active() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['lastAppointmentCounter','updatedAt']));
      allow delete: if admin() && request.auth.uid != uid;
    }

    match /config/{documentId} {
      allow create: if signedIn() && !exists(/databases/$(database)/documents/config/main);
      allow read: if active();
      allow update: if canAny(['settings'])
        || (canAny(['dashboard'])
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['dashboard','updatedAt']));
      allow delete: if canAny(['settings']);
    }

    match /publicConfig/{documentId} {
      allow read: if true;
      allow create: if (signedIn() && !exists(/databases/$(database)/documents/config/main))
        || canAny(['settings']);
      allow update, delete: if canAny(['settings']);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if canAny(['settings']);
    }

    match /counters/{counterId} {
      allow read: if active();
      allow create: if (signedIn() && !exists(/databases/$(database)/documents/config/main))
        || (counterId == 'appointmentNotifications'
          && request.auth == null
          && request.resource.data.count == 1);
      allow update: if (
          counterId == 'appointmentNotifications'
          && request.auth == null
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['count','updatedAt'])
        ) || (
          counterId == 'purchases' && canAny(['purchases'])
        ) || (
          counterId == 'invoices' && canAny(['billing','appointments']) // MODIFICADO: receivables eliminado
        ) || (
          counterId == 'appointmentNotifications' && canAny(['appointments'])
        );
      allow delete: if admin();
    }

    match /appointments/{appointmentId} {
      allow create: if publicAppointmentIsValid() || canAny(['appointments']);
      allow read: if canAny(['appointments']);
      allow update, delete: if canAny(['appointments']);
    }

    match /slotLocks/{slotId} {
      allow read: if true;
      allow create: if (
          request.auth == null
          && request.resource.data.keys().hasOnly([
            'appointmentId','date','startMinute','endMinute','createdAt'
          ])
          && request.resource.data.appointmentId is string
          && request.resource.data.date is string
          && request.resource.data.startMinute is int
          && request.resource.data.endMinute is int
          && request.resource.data.endMinute > request.resource.data.startMinute
          && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        ) || canAny(['appointments']);
      allow update, delete: if canAny(['appointments']);
    }

    match /purchases/{purchaseId} {
      allow read: if canAny(['purchases','purchase-history','dashboard']);
      allow create: if canAny(['purchases']);
      allow update, delete: if canAny(['purchase-history']);
    }

    match /inventory/{productId} {
      allow read: if canAny(['inventory','products','purchases','billing','appointments','sales']); // MODIFICADO
      allow write: if canAny(['inventory','products','purchases','purchase-history','billing','appointments','sales']); // MODIFICADO
    }

    match /products/{productId} {
      allow read: if canAny(['products','inventory','billing','appointments']);
      allow write: if canAny(['products','inventory','purchases','purchase-history']);
    }

    match /expenses/{expenseId} {
      allow read: if canAny(['expenses','expense-history','dashboard']);
      allow create: if canAny(['expenses']);
      allow update, delete: if canAny(['expense-history']);
    }

    match /sales/{saleId} {
      allow read: if canAny(['sales','dashboard','clients']);
      allow create: if canAny(['billing','appointments']); // MODIFICADO
      allow update, delete: if canAny(['sales']);
    }

    // ELIMINADO: reglas exclusivas de la colección receivables.

    match /clients/{clientId} {
      allow read: if canAny(['clients','billing','appointments']);
      allow write: if canAny(['clients','billing','appointments']);
    }

    match /clientStatuses/{statusId} {
      allow read, write: if canAny(['clients']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}`;

